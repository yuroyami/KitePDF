# Test corpora. The public documents that corpus/manifest.json lists are tracked,
# one line each below, with their credits and license notices. Your own PDFs and
# EPUBs under corpus/{pdf,epub} stay local: they can be copyrighted.
corpus/*
!corpus/README.md
!corpus/manifest.json
!corpus/ATTRIBUTION.md
!corpus/licenses/
corpus/licenses/*
